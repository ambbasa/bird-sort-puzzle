{
  "frames": [
    "up",
    "mid",
    "down",
    "mid"
  ],
  "foldFrame": "fold",
  "frameMs": 60,
  "pattern": "assets-birds-bird-{color}-{frame}.svg",
  "timing": {
    "lift": {
      "ms": 120,
      "easing": "cubic-bezier(.2,.8,.2,1)"
    },
    "flight": {
      "msMin": 300,
      "msMax": 400,
      "formula": "clamp(300, 260 + 0.25*|dx|, 400)",
      "easing": "cubic-bezier(.45,0,.25,1)"
    },
    "land": {
      "ms": 260,
      "easing": "keyframes bird-land"
    }
  },
  "path": {
    "type": "quadratic-bezier",
    "P0": "출발 기둥 맨 위 새 위치 - lift 30px",
    "P2": "도착 기둥 다음 빈 칸(가지) 착지 위치",
    "Ypeak": "perchTopY - 0.5*B - clamp(10, 0.1*|dx|, 40)",
    "P1": "((x0+x2)/2, 2*Ypeak - (y0+y2)/2)",
    "note": "t=0.5에서 y=Ypeak → 항상 기둥 꼭대기 위로 넘어감",
    "tilt": "atan2(dy/dt, dx/dt) * 0.35 (max ±20deg)"
  },
